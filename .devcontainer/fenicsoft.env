# Which fenicsoft the devcontainer installs.
# Change it, then either "Dev Containers: Rebuild Container", or (faster, inside the container):
#     make fenicsoft                                  # re-reads this file
#     make fenicsoft FENICSOFT_REF=<branch|tag|sha>   # one-off override
#
# FENICSOFT_SOURCE
#   local    : your clone ../fenicsoft (mounted), installed at FENICSOFT_REF.
#              FENICSOFT_REF may be a local branch, origin/<branch>, a tag or a commit.
#              Installed from a throw-away copy: your working tree / checked-out branch are never touched.
#              Remote branches must have been fetched on the host first.
#   editable : `pip install -e` of ../fenicsoft as currently checked out (FENICSOFT_REF ignored).
#              Use it when editing fenicsoft and the playground together.
#   remote   : pip install from the GitLab at FENICSOFT_REF (needs FENICSOFT_TOKEN,
#              see secrets.env.example).
FENICSOFT_SOURCE=local
# Default ref: the open transfer branch #101 (`fenicsoft.operators.ResidualRows`: quadrature degree, test scale and
# normalization per residual row), on top of main (#100 merged: `fenicsoft.materials.permeability`,
# `fenicsoft.materials.saturated_mixture`, `fenicsoft.materials.volumetric.CompactionVolumetricPenalty`; #99:
# `fenicsoft.materials.cell.active.hill`, `fenicsoft.operators.cell.ContractileEvolution`; #98: `fenicsoft.scaling`; #97:
# `DecimatedTimeIntegrator` with `functions_to_write` and `root_only_logs`; #96: `fenicsoft.io.xdmf_units`/`xdmf_reading`,
# `materials.cell.active.activation`, `materials.orientation.display`; #95: `fenicsoft.ufl_functions`, clipped
# `SaturatedProliferation`; #93: Step in `integration`, mesh cut in `mesh`, aniso law archived, `scale_factor`).
# The playground no longer carries these modules: it needs #101 (back to `main` once merged). `local` installs the
# committed state of the ref; use `editable` to test uncommitted fenicsoft changes.
FENICSOFT_REF=101-transfert-hill-fenicsoft-lignes-de-residu-degre-de-quadrature-echelle-de-test-et-normalisation
FENICSOFT_REMOTE_URL=src.koda.cnrs.fr/lms1/jean-marc-allain/fenicsoft.git

# Restructured dolfin_mech (reinstalled after fenicsoft, as in fenicsoft's `make install`).
DOLFIN_MECH_REF=master
